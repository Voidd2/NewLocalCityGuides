{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "cloudflare:build": "node ./scripts/copy-maplibre-worker.mjs && opennextjs-cloudflare build",
    "preview": "npm run cloudflare:build && opennextjs-cloudflare preview",
    "deploy": "npm run cloudflare:build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "media:check": "node scripts/check-media-assets.mjs",
    "media:optimize": "node scripts/optimize-media.mjs",
    "affiliate:check": "node scripts/check-affiliate-links.mjs",
    "seo:crawl": "node scripts/seo-crawl.mjs",
    "check": "npm run typecheck && npm run lint && npm run media:check && npm run affiliate:check && npm test && npm run build"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.10",
    "maplibre-gl": "^6.11.1",
    "next": "16.3.8",
    "next-intl": "^4.14.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.12.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "wrangler": "4.149.0"
  }
}

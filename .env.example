# Canonical production origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-final-cityguide-domain.example

# Add the final legal identity before enabling checkout. Keep these server-side.
LEGAL_BUSINESS_NAME=
LEGAL_BUSINESS_ADDRESS=
LEGAL_REGISTRATION_NUMBER=
PRIVACY_CONTACT_EMAIL=privacy@yourlocalcityguide.com

# Paste the HTML-tag verification token from Google Search Console.
GOOGLE_SITE_VERIFICATION=

# Private moderation inbox/webhook for genuine review submissions.
REVIEW_WEBHOOK_URL=
REVIEW_WEBHOOK_TOKEN=

# Existing optional newsletter integration.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_AUDIENCE_ID_NL=
RESEND_AUDIENCE_ID_EN=
RESEND_AUDIENCE_ID_DE=
